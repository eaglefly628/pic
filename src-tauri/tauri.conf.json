{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "junbai家专用理财软件",
  "version": "0.1.0",
  "identifier": "com.junbai.familyvault",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5180"
  },
  "app": {
    "windows": [
      {
        "title": "junbai家专用理财软件",
        "width": 1280,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
