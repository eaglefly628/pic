[{"id":"忆江南","name":"忆江南","variant":"白居易体","description":"单调二十七字，五句三平韵","lines":[{"pattern":"平中仄","rhyme":false,"repeat":false,"stanza":1},{"pattern":"中仄仄平平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄中平平仄仄","rhyme":false,"repeat":false,"stanza":1},{"pattern":"中平平仄仄平平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"平仄仄平平","rhyme":true,"repeat":false,"stanza":1}],"note":"按温庭筠词：“千万恨，恨极在天涯。山月不知心里事，水风空落眼前花，摇曳碧云斜。”正与此同，平仄参之。","source":"https://www.sou-yun.cn/QueryCiTune.aspx"},{"id":"如梦令","name":"如梦令","variant":"后唐庄宗体","description":"单调三十三字，七句五仄韵、一叠韵","lines":[{"pattern":"中仄中平中仄","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄中平中仄","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄仄平平","rhyme":false,"repeat":false,"stanza":1},{"pattern":"中仄中平中仄","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄","rhyme":true,"repeat":true,"stanza":1},{"pattern":"中仄中平中仄","rhyme":true,"repeat":false,"stanza":1}],"note":"此调以此词为正体，第五、六句例用叠句。若《梅苑》、《鸣鹤馀音》词皆变体也。\n按白居易词首句“前度小花静院”，“静”字仄声。沈会宗词第五、六句“不见。不见。”，两“不”字俱仄声。白词第七句“记取钗横鬓乱”，“鬓”字仄声。谱内可平可仄据此，其馀悉参后词。\n又按苏轼词第三句“唤起百舌儿”，“舌”字入声，宋元人此字从无用仄声者，当是以入作平，不可泛用上去声字。","source":"https://www.sou-yun.cn/QueryCiTune.aspx"},{"id":"浣溪沙","name":"浣溪沙","variant":"韩偓体","description":"双调四十二字，前段三句三平韵，后段三句两平韵","lines":[{"pattern":"中仄中平中仄平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中平中仄仄平平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中平中仄仄平平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄中平平仄仄","rhyme":false,"repeat":false,"stanza":2},{"pattern":"中平中仄仄平平","rhyme":true,"repeat":false,"stanza":2},{"pattern":"中平中仄仄平平","rhyme":true,"repeat":false,"stanza":2}],"note":"此调以此词为正体，若薛词之少押一韵，孙词、顾词之摊破句法，李词之换仄韵，皆变体也。\n前段第二句，韦庄词“孤灯照壁背窗纱”，“孤”字平声，“照”字仄声。后段第二句，欧阳炯词“园中缓步折花枝”，“缓”字仄声。第三句，李煜词“登临不惜更沾衣”，“登”字平声，“不”字仄声。谱内可平可仄据此，其馀悉参后词。\n至《花草粹编》所载李氏一词，前段第三句“流水飘香乳燕啼”，历查唐宋元诸家平韵词，此句从无第二第六字用仄、第四字用平者，李词误填，不可从。","source":"https://www.sou-yun.cn/QueryCiTune.aspx"},{"id":"长相思","name":"长相思","variant":"白居易体","description":"双调三十六字，前后段各四句，三平韵、一叠韵","lines":[{"pattern":"中中平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"仄中平","rhyme":true,"repeat":true,"stanza":1},{"pattern":"平仄平平仄仄平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"平平仄仄平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"仄平平","rhyme":true,"repeat":false,"stanza":2},{"pattern":"中平平","rhyme":true,"repeat":true,"stanza":2},{"pattern":"仄仄平平平仄平","rhyme":true,"repeat":false,"stanza":2},{"pattern":"仄平平仄平","rhyme":true,"repeat":false,"stanza":2}],"note":"此调以此词及欧词为正体，其馀押韵异同，皆变格也。\n此词前后段起二句俱用叠韵，如冯延巳词之“红满枝，绿满枝”、“忆归期，数归期”，张辑词之“山无情，水无情”、“拟行行，重行行”皆照此填。","source":"https://www.sou-yun.cn/QueryCiTune.aspx"},{"id":"卜算子","name":"卜算子","variant":"苏轼体","description":"双调四十四字，前后段各四句、两仄韵","lines":[{"pattern":"中中中中平","rhyme":false,"repeat":false,"stanza":1},{"pattern":"中仄平平仄","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄平平中中中","rhyme":false,"repeat":false,"stanza":1},{"pattern":"中仄平平仄","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中中中中平","rhyme":false,"repeat":false,"stanza":2},{"pattern":"中仄平平仄","rhyme":true,"repeat":false,"stanza":2},{"pattern":"中仄平平中中中","rhyme":false,"repeat":false,"stanza":2},{"pattern":"仄仄平平仄","rhyme":true,"repeat":false,"stanza":2}],"note":"此调以此词为正体，若石词之多押两韵，徐、黄、张、杜四词之添字，皆变体也。\n苏词别首前段第二句“长忆吴山好”，“长”字平声。谱内据之，其馀可平可仄，悉参下词。","source":"https://www.sou-yun.cn/QueryCiTune.aspx"},{"id":"采桑子","name":"采桑子","variant":"和凝体","description":"双调四十四字，前后段各四句、三平韵","lines":[{"pattern":"中平中仄平平仄","rhyme":false,"repeat":false,"stanza":1},{"pattern":"中仄平平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄平平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中仄平平中仄平","rhyme":true,"repeat":false,"stanza":1},{"pattern":"中平中仄平平仄","rhyme":false,"repeat":false,"stanza":2},{"pattern":"中仄平平","rhyme":true,"repeat":false,"stanza":2},{"pattern":"中仄平平","rhyme":true,"repeat":false,"stanza":2},{"pattern":"中仄平平中仄平","rhyme":true,"repeat":false,"stanza":2}],"note":"此调以此词为正体，若李词、朱词之添字，皆变体也。\n按冯延巳词前段第一句“马嘶人语春风岸”，“马”字仄声，“人”字平声。第二句“芳草绵绵”，“芳”字平声。第三句“梦过金扉”，“梦”字仄声。结句“花谢窗前夜合枝”，“花”字平声。又“落尽灯花鸡未啼”，“鸡”字平声。后段第一句“起来捡点经游地”，“起”字、“捡”字俱仄声。第二句“处处新愁”，上“处”字仄声。第三句“不语含情”，“不”字仄声。结句“水调何人吹笛声”，“水”字仄声，“吹”字平声。谱内可平可仄据此。若两结句第三四字，例用平平，则不可移易也。","source":"https://www.sou-yun.cn/QueryCiTune.aspx"}]