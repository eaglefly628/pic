{
  // VS Code 调试配置：F5 直接启动统一服务器（打开 http://localhost:5180）。
  // 平时本地开发/Debug 用 Python 版最顺手；两版行为一致、读写同一个数据目录。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: run.py（本地调试首选）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "env": { "HOME_CHANNEL": "dev" }
    },
    {
      "name": "Node: desktop/server.js（App 同款后端）",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/desktop/server.js",
      "console": "integratedTerminal",
      "env": { "HOME_CHANNEL": "dev" }
    }
  ]
}
